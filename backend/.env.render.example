# Copy these names into Render's Environment tab. Do not commit real values.
# Replace the placeholders with Neon connection strings.
HR_MIGRATION_DATABASE_URL=postgresql+asyncpg://<schema-owner>:<password>@<neon-direct-host>/<database>?ssl=require
HR_APP_DATABASE_URL=postgresql+asyncpg://hr_app:<HR_APP_DB_PASSWORD>@<neon-pooled-host>/<database>?ssl=require
HR_APP_DB_PASSWORD=<same-password-used-in-HR_APP_DATABASE_URL>
HR_COOKIE_SECURE=true
HR_RESET_PASSWORD_TOKEN_SECRET=<generated-secret>
HR_VERIFICATION_TOKEN_SECRET=<generated-secret>
HR_RESUME_AI_PROVIDER=groq
HR_GROQ_API_KEY=<optional-provider-key>
