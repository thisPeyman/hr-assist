# Merge the values you need into backend/.env; do not overwrite existing credentials.
HR_APP_DATABASE_URL=postgresql+asyncpg://hr_app:hr_app_dev@127.0.0.1:5432/hr_dev
HR_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/hr_dev
HR_COOKIE_SECURE=false
HR_OPENAI_API_KEY=
# Model names stay configurable; choose models available to your API account.
HR_RESUME_EXTRACT_MODEL=gpt-5.6-luna
HR_RESUME_EXTRACT_MODEL_ESCALATION=gpt-6.1-sol
# Optional: otherwise summaries use HR_RESUME_EXTRACT_MODEL.
# HR_RESUME_SUMMARY_MODEL=
# Optional Groq cloud provider (separate API key and model names).
# HR_RESUME_AI_PROVIDER=groq
# HR_GROQ_API_KEY=
# HR_GROQ_BASE_URL=https://api.groq.com/openai/v1
# HR_RESUME_EXTRACT_MODEL=qwen/qwen3.8-27b
# HR_RESUME_EXTRACT_MODEL_ESCALATION=qwen/qwen3.8-27b
# Optional local, account-free vision model: install Ollama, pull qwen3-vl:4b,
# then set HR_RESUME_AI_PROVIDER=ollama and replace both model values above.
# HR_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/

# Placeholder only. No real domain, DNS or Cloudflare connection is configured.
HR_INBOUND_DOMAIN=jobs.yourdomain.com
HR_INBOUND_WEBHOOK_SECRET=replace-with-a-random-local-secret
HR_INBOUND_STORAGE_DIR=.data/inbound
HR_INBOUND_MAX_BYTES=26214400
# Optional S3-compatible durable storage. Empty bucket uses local disk.
HR_INBOUND_S3_BUCKET=
HR_INBOUND_S3_ENDPOINT_URL=
# S3 credentials use the standard AWS environment/profile provider chain.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=auto

# External document tools (absolute executable paths also work on Windows).
HR_CLAMAV_COMMAND=clamscan
HR_OCR_ENABLED=true
HR_OCR_COMMAND=ocrmypdf
HR_VISION_ENABLED=true
HR_LEGACY_CONVERSION_ENABLED=false
HR_LIBREOFFICE_COMMAND=soffice
HR_DOCUMENT_COMMAND_TIMEOUT=120
HR_RESUME_MAX_PAGES=20

# Candidate search: opt in separately; blank models/keys keep lexical fallback.
# OpenAI-compatible gateways/local models can set explicit base URLs + dummy keys.
HR_SEARCH_QUERY_MODEL=
HR_SEARCH_API_KEY=
# HR_SEARCH_BASE_URL=http://127.0.0.1:11434/v1
HR_SEARCH_EMBEDDING_MODEL=
HR_SEARCH_EMBEDDING_API_KEY=
HR_SEARCH_EMBEDDING_DIMENSIONS=1536
# HR_SEARCH_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# See docs/candidate-search.md before reindexing/backfilling via a paid provider.
